{
  "Lua.runtime.version": "Lua 5.4",
  "Lua.runtime.builtin": {
    "bit32": "enable",
    "bit": "disable",
    "utf8": "enable"
  },
  "Lua.diagnostics.enable": true,
  "Lua.diagnostics.disable": ["cast-local-type"],
  "Lua.diagnostics.severity": {
    "no-unknown": "Error",
    "undefined-global": "Error",
    "undefined-field": "Error",
    "unused-vararg": "Warning",
    "unused-function": "Warning",
    "unknown-cast-variable": "Error",
    "param-type-mismatch": "Error",
    "inject-field": "Error"
  },
  "cSpell.words": [
    "boarddata",
    "boardinstaller",
    "boardlib",
    "boardredstone",
    "boardstartup",
    "boardtimer",
    "boardui",
    "detectplayer",
    "displayinstaller",
    "fdnkg",
    "Ggbh",
    "Hxwpy",
    "installboard",
    "installdisplay",
    "installmonhost",
    "Knhfg",
    "leveldisplay",
    "levelpositions",
    "Lgtd",
    "monhost",
    "monhostinstaller",
    "monhostname",
    "monhoststartup",
    "nums",
    "pastebin",
    "qzpp",
    "rednet",
    "respawn",
    "setupboard",
    "setupmonhost",
    "setuptimer",
    "startendpos",
    "startpos",
    "Stnx",
    "textutils",
    "unserialize",
    "vararg",
    "Vnan",
    "xmonhost",
    "xtimer"
  ]
}
